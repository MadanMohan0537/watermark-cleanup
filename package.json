{
  "name": "watermark-cleanup",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-focused watermark cleanup for images, PDFs, and documents.",
  "license": "MIT",
  "author": "Madan Mohan",
  "homepage": "https://watermark-cleanup.madanmohanlearning.workers.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MadanMohan0537/watermark-cleanup.git"
  },
  "bugs": {
    "url": "https://github.com/MadanMohan0537/watermark-cleanup/issues"
  },
  "keywords": [
    "watermark",
    "image-processing",
    "pdf",
    "nextjs",
    "cloudflare-workers",
    "privacy"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:next": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:fixtures": "node scripts/generate-fixtures.mjs",
    "generate:assets": "node scripts/generate-public-assets.mjs",
    "verify:worker": "node -e \"require('fs').accessSync('.open-next/worker.js'); console.log('Verified .open-next/worker.js')\"",
    "build:cloudflare": "opennextjs-cloudflare build",
    "build:worker": "npm run build:cloudflare && npm run verify:worker",
    "preview": "npm run build:worker && opennextjs-cloudflare preview",
    "deploy": "npm run build:worker && opennextjs-cloudflare deploy",
    "upload": "npm run build:worker && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.14.4",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-png": "^6.4.0",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^0.544.0",
    "next": "16.3.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.394",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jpeg-js": "^0.3.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "wrangler": "^4.34.0"
  }
}
